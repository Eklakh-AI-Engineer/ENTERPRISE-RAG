{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise RAG Phase 2 Benchmark",
  "type": "object",
  "required": [
    "benchmark_version",
    "corpus",
    "queries"
  ],
  "properties": {
    "benchmark_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "corpus": {
      "type": "object",
      "required": [
        "corpus_id",
        "document_hash"
      ],
      "properties": {
        "corpus_id": {
          "type": "string"
        },
        "document_hash": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "chunker_version": {
          "type": "string"
        },
        "embedding_model": {
          "type": "string"
        },
        "embedding_version": {
          "type": "string"
        },
        "reranker_model": {
          "type": "string"
        },
        "retrieval_top_k": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_k": {
          "type": "integer",
          "minimum": 1
        },
        "rrf_k": {
          "type": "integer",
          "minimum": 1
        },
        "random_seed": {
          "type": "integer"
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "query_id",
          "category",
          "query",
          "relevance"
        ],
        "properties": {
          "query_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "relevance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "document_id",
                "page",
                "start_char",
                "end_char",
                "relevance"
              ],
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "start_char": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_char": {
                  "type": "integer",
                  "minimum": 0
                },
                "relevance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            }
          }
        }
      }
    }
  }
}