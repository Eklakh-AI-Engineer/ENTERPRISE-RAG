# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Local retrieval indexes
DENSE_INDEX_PATH=data/processed/dense.index
DENSE_METADATA_PATH=data/processed/dense_metadata.json
BM25_METADATA_PATH=data/processed/bm25_metadata.json

# Retrieval models
DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval parameters
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
CANDIDATE_K=10

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents
MAX_UPLOAD_BYTES=20971520
INGESTION_PIPELINE_VERSION=pdf-ingest-v2-ocr-recursive-v2
